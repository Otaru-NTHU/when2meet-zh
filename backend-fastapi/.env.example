# 複製成 .env 後修改。沒設定 SMTP 時，通知只會印在終端機。
DB_PATH=./data/meet.sqlite3
FRONTEND_URL=https://meet.example.com        # 信件裡的連結用；由 FastAPI 直接服務前端時填自己的網址
DIGEST_HOUR=9                                # 每日摘要寄出時間（伺服器本地時間）

# SMTP（Gmail 範例：用「應用程式密碼」，不是登入密碼）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=約時間 <you@gmail.com>
